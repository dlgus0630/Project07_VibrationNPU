digraph G {
graph [fontname="Noto Sans CJK KR", fontsize=24, rankdir=TB, bgcolor="white", pad=0.45, nodesep=0.5, ranksep=0.65, compound=true, dpi=150, labelloc=t, labeljust=l, label="03 · INT8 2-PE NPU FSM · 4 states\nRTL 상태천이도 · 실선: nextstate_proc에서 추출 · 파선: 공통 reset / 복구"];
node [fontname="Noto Sans CJK KR", fontsize=17, shape=box, style="rounded,filled", fillcolor="#edf5fc", color="#476681", penwidth=1.6, margin="0.22,0.14"];
edge [fontname="Noto Sans CJK KR", fontsize=14, color="#405b70", fontcolor="#263e50", penwidth=1.5, arrowsize=0.8];
"IDLE" [label="IDLE  [0]\nstart 수락: 입력 특징 저장 / hidden=0\nneuron_pair=0 / busy=1 / cycles=0", shape=box, fillcolor="#edf5fc"];
"INIT" [label="INIT  [1]\nclear_mac=1 → 두 PE에 bias 적재\ninput_index=0", shape=box, fillcolor="#edf5fc"];
"MAC" [label="MAC  [2]\nenable_mac=1 → 두 뉴런 동시 누산\n입력 0..3 / 미완료 시 input_index 증가", shape=box, fillcolor="#edf5fc"];
"PACK" [label="PACK  [3]\n양자화 후 두 결과 저장\npair 0/1: hidden ReLU / pair 2: logits·class", shape=box, fillcolor="#edf5fc"];
"IDLE" -> "INIT" [label="(start = '1')"];
"IDLE" -> "IDLE" [label="NOT ((start = '1'))"];
"INIT" -> "MAC" [label="다음 clk"];
"MAC" -> "PACK" [label="(input_index = 3)"];
"MAC" -> "MAC" [label="NOT ((input_index = 3))"];
"PACK" -> "IDLE" [label="(neuron_pair = 2)"];
"PACK" -> "INIT" [label="NOT ((neuron_pair = 2))"];
"reset" [label="모든 상태 / 미사용 인코딩\nrst=1: 다음 상승 에지에 IDLE\nOTHERS: 다음 상태 IDLE", shape=box, fillcolor="#f5f5f4"];
"reset" -> "IDLE" [label="우선 reset / 예외 복구", style="dashed", color="#987290"];
"notes" [label="읽는 기준 / 코드 근거\nneuron_pair=0: 은닉 뉴런 0·1, =1: 은닉 뉴런 2·3, =2: 두 logits\n마지막 PACK 처리 에지: busy=0 / done=1\n그 외 PACK 처리 에지: neuron_pair 증가\nU_PE0 / U_PE1: mac_pe / rst > clear(bias) > enable(acc+x×w) > hold\nclass_id = (quantized1 > quantized0). 같은 점수는 class 0.\n노드 동작: 해당 현재 상태에서 처리하는 클럭 기준.\n조건 불충족 self-loop는 next_state 기본값=state에서 추출.", shape=box, fillcolor="#f5f5f4"];
"PACK" -> "notes" [label="", style="invis", color="#987290"];
}
